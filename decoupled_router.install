<?php

/**
 * @file
 * Module install file for Decoupled Router module.
 */

declare(strict_types=1);

use Drupal\Component\Utility\DeprecationHelper;
use Drupal\Core\Extension\Requirement\RequirementSeverity;
use Drupal\Core\Hook\Attribute\LegacyRequirementsHook;

/**
 * Implements hook_requirements().
 *
 * Drupal 11.3 and later run
 * \Drupal\decoupled_router\Hook\RequirementsHooks instead, because of the
 * attribute below. This implementation serves Drupal 10 and 11.2, which have
 * no hook_runtime_requirements() to call.
 */
#[LegacyRequirementsHook]
function decoupled_router_requirements($phase): array {
  // Drupal runs this hook for the install phase before the module is
  // installed, so neither its services nor its classes can be reached yet.
  // Drupal 11.3 and later have no install phase here at all, because
  // hook_runtime_requirements() is runtime only, so returning nothing keeps
  // every supported version behaving the same way.
  if ($phase !== 'runtime') {
    return [];
  }
  $requirement = \Drupal::service('decoupled_router.redirect_compatibility')
    ->getRequirement();
  if ($requirement === NULL) {
    return [];
  }
  $requirement['severity'] = DeprecationHelper::backwardsCompatibleCall(
    \Drupal::VERSION,
    '11.2.0',
    fn(): RequirementSeverity => RequirementSeverity::Error,
    fn(): int => REQUIREMENT_ERROR,
  );

  return ['decoupled_router_redirect' => $requirement];
}

/**
 * Creates the decoupled_router.settings configuration.
 */
function decoupled_router_update_20001(): void {
  \Drupal::configFactory()->getEditable('decoupled_router.settings')
    ->set('absolute_resolved_urls', TRUE)->save();
}
